{
  "base": "dark",
  "tokens": {
    "--background": "#282828",
    "--editor-surface": "#282828",
    "--foreground": "#e2cca9",
    "--card": "#282828",
    "--card-foreground": "#e2cca9",
    "--popover": "#32302f",
    "--popover-foreground": "#e2cca9",
    "--primary": "#b0b846",
    "--primary-foreground": "#282828",
    "--secondary": "#3c3836",
    "--secondary-foreground": "#e2cca9",
    "--muted": "#3c3836",
    "--muted-foreground": "#bbaa90",
    "--accent": "#45403d",
    "--accent-foreground": "#e2cca9",
    "--border": "#45403d",
    "--input": "#32302f",
    "--ring": "#b0b846",
    "--sidebar": "#282828",
    "--sidebar-foreground": "#e2cca9",
    "--sidebar-primary": "#b0b846",
    "--sidebar-primary-foreground": "#282828",
    "--sidebar-accent": "#45403d",
    "--sidebar-accent-foreground": "#e2cca9",
    "--sidebar-border": "#45403d",
    "--sidebar-ring": "#b0b846",
    "--worktree-sidebar": "#282828",
    "--worktree-sidebar-border": "#45403d",
    "--chart-1": "#b0b846",
    "--chart-2": "#f28534",
    "--chart-3": "#80aa9e",
    "--chart-4": "#d3869b",
    "--chart-5": "#e9b143",
    "--tab-bar": "#1b1b1b",
    "--tab-active": "#282828",
    "--tab-active-foreground": "#e2cca9",
    "--tab-active-indicator": "#b0b846",
    "--tab-inactive": "#1b1b1b",
    "--tab-inactive-foreground": "#bbaa90",
    "--split-divider": "#45403d",
    "--split-divider-hover": "#b0b846",
    "--chat-bold-foreground": "#e2cca9",
    "--chat-inline-code-foreground": "#93bc83",
    "--text-link": "#80aa9e",
    "--editor-selection": "#e2cca926",
    "--diff-added": "#b0b846",
    "--diff-added-background": "#34381b",
    "--diff-added-emphasis": "#3b4439",
    "--diff-added-gutter": "#515331",
    "--diff-removed": "#f2594b",
    "--diff-removed-background": "#402120",
    "--diff-removed-emphasis": "#4c3432",
    "--diff-removed-gutter": "#653732",
    "--git-decoration-added": "#b0b846",
    "--git-decoration-modified": "#f28534",
    "--git-decoration-deleted": "#f2594b",
    "--git-decoration-renamed": "#80aa9e",
    "--git-decoration-untracked": "#b0b846",
    "--git-decoration-copied": "#8bba7f",
    "--git-decoration-ignored": "#928374"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#928374",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variables and parameters",
      "scope": [
        "variable",
        "variable.parameter",
        "variable.other.constant",
        "constant.other"
      ],
      "settings": {
        "foreground": "#e2cca9"
      }
    },
    {
      "name": "Properties and keys",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#80aa9e",
        "fontStyle": ""
      }
    },
    {
      "name": "Built-in variables",
      "scope": [
        "variable.language",
        "support.variable",
        "support.constant"
      ],
      "settings": {
        "foreground": "#d3869b"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant"
      ],
      "settings": {
        "foreground": "#8bba7f"
      }
    },
    {
      "name": "Numbers, booleans and built-in constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#d3869b"
      }
    },
    {
      "name": "Characters",
      "scope": [
        "constant.character"
      ],
      "settings": {
        "foreground": "#8bba7f"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type"
      ],
      "settings": {
        "foreground": "#f2594b"
      }
    },
    {
      "name": "Storage modifiers",
      "scope": [
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#f28534"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#f28534"
      }
    },
    {
      "name": "Preprocessor",
      "scope": [
        "meta.preprocessor",
        "keyword.control.directive",
        "entity.name.function.preprocessor"
      ],
      "settings": {
        "foreground": "#d3869b"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string",
        "markup.inline.raw",
        "markup.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#8bba7f"
      }
    },
    {
      "name": "Escapes and regular expressions",
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "constant.other.character-class.regexp"
      ],
      "settings": {
        "foreground": "#b0b846"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#b0b846",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#e9b143",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Namespaces",
      "scope": [
        "entity.name.namespace",
        "entity.name.type.module"
      ],
      "settings": {
        "foreground": "#e9b143",
        "fontStyle": ""
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#e2cca9"
      }
    },
    {
      "name": "Delimiters",
      "scope": [
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#928374"
      }
    },
    {
      "name": "Embedded punctuation",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded",
        "punctuation.definition.interpolation"
      ],
      "settings": {
        "foreground": "#80aa9e"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#f28534"
      }
    },
    {
      "name": "Tag delimiters and attributes",
      "scope": [
        "punctuation.definition.tag",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#b0b846"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#d3869b",
        "fontStyle": ""
      }
    },
    {
      "name": "Labels",
      "scope": [
        "entity.name.label",
        "punctuation.definition.label"
      ],
      "settings": {
        "foreground": "#f28534"
      }
    },
    {
      "name": "Headings",
      "scope": [
        "markup.heading",
        "entity.name.section",
        "punctuation.definition.heading"
      ],
      "settings": {
        "foreground": "#f28534",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strikethrough",
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "foreground": "#928374",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#80aa9e",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Quotes",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#928374",
        "fontStyle": "italic"
      }
    },
    {
      "name": "List markers",
      "scope": [
        "punctuation.definition.list",
        "markup.list.numbered.bullet",
        "beginning.punctuation.definition.list"
      ],
      "settings": {
        "foreground": "#f2594b"
      }
    },
    {
      "name": "Separators",
      "scope": [
        "meta.separator"
      ],
      "settings": {
        "foreground": "#928374"
      }
    },
    {
      "name": "Inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#b0b846"
      }
    },
    {
      "name": "Deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#f2594b"
      }
    },
    {
      "name": "Changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#f28534"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#f2594b"
      }
    }
  ]
}
