{
  "base": "dark",
  "tokens": {
    "--background": "#1d2021",
    "--editor-surface": "#1d2021",
    "--foreground": "#d4be98",
    "--card": "#1d2021",
    "--card-foreground": "#d4be98",
    "--popover": "#282828",
    "--popover-foreground": "#d4be98",
    "--primary": "#a9b665",
    "--primary-foreground": "#1d2021",
    "--secondary": "#32302f",
    "--secondary-foreground": "#d4be98",
    "--muted": "#32302f",
    "--muted-foreground": "#b0a088",
    "--accent": "#3c3836",
    "--accent-foreground": "#d4be98",
    "--border": "#3c3836",
    "--input": "#282828",
    "--ring": "#a9b665",
    "--sidebar": "#1d2021",
    "--sidebar-foreground": "#d4be98",
    "--sidebar-primary": "#a9b665",
    "--sidebar-primary-foreground": "#1d2021",
    "--sidebar-accent": "#3c3836",
    "--sidebar-accent-foreground": "#d4be98",
    "--sidebar-border": "#3c3836",
    "--sidebar-ring": "#a9b665",
    "--worktree-sidebar": "#1d2021",
    "--worktree-sidebar-border": "#3c3836",
    "--chart-1": "#a9b665",
    "--chart-2": "#e78a4e",
    "--chart-3": "#7daea3",
    "--chart-4": "#d3869b",
    "--chart-5": "#d8a657",
    "--tab-bar": "#141617",
    "--tab-active": "#1d2021",
    "--tab-active-foreground": "#d4be98",
    "--tab-active-indicator": "#a9b665",
    "--tab-inactive": "#141617",
    "--tab-inactive-foreground": "#b0a088",
    "--split-divider": "#3c3836",
    "--split-divider-hover": "#a9b665",
    "--chat-bold-foreground": "#d4be98",
    "--chat-inline-code-foreground": "#89b482",
    "--text-link": "#7daea3",
    "--editor-selection": "#d4be9826",
    "--diff-added": "#a9b665",
    "--diff-added-background": "#32361a",
    "--diff-added-emphasis": "#333e34",
    "--diff-added-gutter": "#474d35",
    "--diff-removed": "#ea6962",
    "--diff-removed-background": "#3c1f1e",
    "--diff-removed-emphasis": "#442e2d",
    "--diff-removed-gutter": "#5a3634",
    "--git-decoration-added": "#a9b665",
    "--git-decoration-modified": "#e78a4e",
    "--git-decoration-deleted": "#ea6962",
    "--git-decoration-renamed": "#7daea3",
    "--git-decoration-untracked": "#a9b665",
    "--git-decoration-copied": "#89b482",
    "--git-decoration-ignored": "#928374"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#928374",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variables and parameters",
      "scope": [
        "variable",
        "variable.parameter",
        "variable.other.constant",
        "constant.other"
      ],
      "settings": {
        "foreground": "#d4be98"
      }
    },
    {
      "name": "Properties and keys",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#7daea3",
        "fontStyle": ""
      }
    },
    {
      "name": "Built-in variables",
      "scope": [
        "variable.language",
        "support.variable",
        "support.constant"
      ],
      "settings": {
        "foreground": "#d3869b"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant"
      ],
      "settings": {
        "foreground": "#89b482"
      }
    },
    {
      "name": "Numbers, booleans and built-in constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#d3869b"
      }
    },
    {
      "name": "Characters",
      "scope": [
        "constant.character"
      ],
      "settings": {
        "foreground": "#89b482"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type"
      ],
      "settings": {
        "foreground": "#ea6962"
      }
    },
    {
      "name": "Storage modifiers",
      "scope": [
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#e78a4e"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#e78a4e"
      }
    },
    {
      "name": "Preprocessor",
      "scope": [
        "meta.preprocessor",
        "keyword.control.directive",
        "entity.name.function.preprocessor"
      ],
      "settings": {
        "foreground": "#d3869b"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string",
        "markup.inline.raw",
        "markup.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#89b482"
      }
    },
    {
      "name": "Escapes and regular expressions",
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "constant.other.character-class.regexp"
      ],
      "settings": {
        "foreground": "#a9b665"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#a9b665",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#d8a657",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Namespaces",
      "scope": [
        "entity.name.namespace",
        "entity.name.type.module"
      ],
      "settings": {
        "foreground": "#d8a657",
        "fontStyle": ""
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#d4be98"
      }
    },
    {
      "name": "Delimiters",
      "scope": [
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#928374"
      }
    },
    {
      "name": "Embedded punctuation",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded",
        "punctuation.definition.interpolation"
      ],
      "settings": {
        "foreground": "#7daea3"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#e78a4e"
      }
    },
    {
      "name": "Tag delimiters and attributes",
      "scope": [
        "punctuation.definition.tag",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#a9b665"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#d3869b",
        "fontStyle": ""
      }
    },
    {
      "name": "Labels",
      "scope": [
        "entity.name.label",
        "punctuation.definition.label"
      ],
      "settings": {
        "foreground": "#e78a4e"
      }
    },
    {
      "name": "Headings",
      "scope": [
        "markup.heading",
        "entity.name.section",
        "punctuation.definition.heading"
      ],
      "settings": {
        "foreground": "#e78a4e",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strikethrough",
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "foreground": "#928374",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#7daea3",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Quotes",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#928374",
        "fontStyle": "italic"
      }
    },
    {
      "name": "List markers",
      "scope": [
        "punctuation.definition.list",
        "markup.list.numbered.bullet",
        "beginning.punctuation.definition.list"
      ],
      "settings": {
        "foreground": "#ea6962"
      }
    },
    {
      "name": "Separators",
      "scope": [
        "meta.separator"
      ],
      "settings": {
        "foreground": "#928374"
      }
    },
    {
      "name": "Inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#a9b665"
      }
    },
    {
      "name": "Deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#ea6962"
      }
    },
    {
      "name": "Changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#e78a4e"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#ea6962"
      }
    }
  ]
}
